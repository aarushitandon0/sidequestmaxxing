# Copy to .env and fill in locally. NEVER commit .env. Placeholders only.

# --- API (apps/api) ---
ENV=development
WEB_ORIGIN=http://localhost:5173
GIT_SHA=dev
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sqm
# One of these: LLM_HOSTPORT is set by Render (host:port); LLM_BASE_URL overrides for local dev.
LLM_HOSTPORT=
LLM_BASE_URL=http://localhost:8080
# `model` sent to the chat endpoint: any value for llama.cpp, a pulled tag for Ollama (e.g. qwen3:4b)
LLM_MODEL=quest
LLM_TIMEOUT_S=25
FALLBACK_ON_LLM_ERROR=true
ELEVENLABS_API_KEY=<elevenlabs-key>
ELEVENLABS_VOICE_ID=<voice-id>
TTS_DAILY_CHAR_BUDGET=20000
# Optional voice tuning (defaults shown): low-latency model, MP3 ≤128 kbps works on the free tier
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64
TTS_TIMEOUT_S=10
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional: where prompts/ lives (Docker image uses /prompts)
PROMPTS_DIR=

# --- Web (apps/web) — public values only, they end up in the bundle ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SENTRY_DSN=
# Optional: an UNGATED Gemma 3n -Web .litertlm URL you are allowed to serve (see DECISIONS D-48).
# Empty = players import the model file themselves in Settings.
VITE_GEMMA_MODEL_URL=

# --- LLM service (services/llm) ---
MODEL_URL=https://huggingface.co/<org>/<repo>/resolve/main/<file>.gguf
MODEL_SHA256=
MODEL_FILE=quest.gguf
CTX_SIZE=2048

# --- Scripts ---
API_BASE_URL=http://localhost:8000
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Training only (never on Render): Tinker API key, Hugging Face token for the public model upload
TINKER_API_KEY=
HF_TOKEN=

# --- Scripts: live events (SerpApi). Offline fetch script ONLY; the API never reads this. ---
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
EVENTS_CITY=Pune
EVENTS_BBOX=18.43,73.73,18.63,73.99
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
